{
  "name": "capture-the-flag",
  "version": "0.0.1",
  "description": "ctf-server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "lint": "comfy-tslint src/*.{ts,tsx}",
    "test": "CTF_DB_PATH=:memory: ts-mocha -p tsconfig.json src/**/*_test.ts",
    "server": "node .",
    "start": "tsc-watch -p tsconfig.json --onSuccess \"node .\"",
    "tunnel": "ngrok http ${PORT:-8088}",
    "start:tunnel": "concurrently -n server,ngrok -c blue,green \"npm run start\" \"npm run tunnel\""
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^11.3.0",
    "express": "^4.18.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/assert": "^1.5.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.17",
    "@types/mocha": "^5.2.7",
    "@types/ws": "^8.5.12",
    "assert": "^2.0.0",
    "comfy-tslint": "^0.1.9",
    "concurrently": "^9.2.4",
    "mocha": "^10.1.0",
    "ts-mocha": "^10.0.0",
    "tsc-watch": "^6.0.4",
    "typescript": "^4.8.4"
  }
}
